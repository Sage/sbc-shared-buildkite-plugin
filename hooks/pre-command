#!/usr/bin/env bash
set -euo pipefail

plugin_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
environment_file="$(mktemp)"

if python3 -B "$plugin_root/lib/sbc_shared_cli.py" pre-command "$environment_file"; then
  source "$environment_file"
else
  pre_command_status=$?
  rm -f "$environment_file"
  unset environment_file plugin_root
  return "$pre_command_status" 2>/dev/null || exit "$pre_command_status"
fi

rm -f "$environment_file"
unset environment_file plugin_root
